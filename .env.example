NODE_ENV=development
PORT=8000
FRONTEND_ORIGINS=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=subaybay
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=false
# For TiDB Cloud public endpoint TLS, set DB_SSL=true and optionally provide the CA path:
# MYSQL_ATTR_SSL_CA=/path/to/ca.pem

# Local uploads are stored here. On Render Free this filesystem is ephemeral.
LOCAL_STORAGE_PATH=./storage
DB_CONNECTION_LIMIT=10
